# GPU Worker Image — Phase 0 & Phase 1 Geometry Pipeline
# Single reproducible base image with pinned CUDA, PyTorch, COLMAP, and Nerfstudio.
#
# License notes:
#   - PyTorch: BSD-3-Clause
#   - COLMAP: BSD-3-Clause
#   - FFmpeg: LGPL 2.1+
#   - Nerfstudio / Splatfacto: Apache 2.0
#   - gsplat: Apache 2.0
#
# Build command:
#   docker build -f apps/api/Dockerfile.gpu -t cinevideo-gpu:latest .
#
# Startup capability check:
#   docker run --gpus all cinevideo-gpu:latest python scripts/check_gpu_env.py

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel

WORKDIR /app

# ---- System dependencies ----------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    colmap \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# ---- 3D Gaussian Splatting & Nerfstudio -------------------------------------
RUN pip install --no-cache-dir \
    "nerfstudio==1.1.3" \
    "gsplat>=1.3,<2"

# ---- Application & internal packages ----------------------------------------
COPY apps/api/pyproject.toml /app/pyproject.toml
COPY apps/api/app /app/app
COPY packages /app/packages
COPY apps/api/scripts /app/scripts

ENV PYTHONPATH="/app"

RUN pip install --no-cache-dir .

EXPOSE 8000

# Default entry point runs environment capability check.
# Can be overridden with uvicorn or worker in docker-compose.
CMD ["python", "scripts/check_gpu_env.py"]
